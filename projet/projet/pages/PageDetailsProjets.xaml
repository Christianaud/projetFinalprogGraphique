<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="projet.pages.PageDetailsProjets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:projet.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local1="using:projet.classes"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Background="#FFF8F8F8" CornerRadius="10" Padding="20" Margin="10" BorderBrush="Black">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Détails du Projet"
                   FontSize="36" FontWeight="Bold" Foreground="Black"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Numéro :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbxNumero" Foreground="Gray"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Titre :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbxTitre" Foreground="Gray"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Statut :" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbxStatut" Foreground="Gray"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Nom Client :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="tbxNomClient" Foreground="Gray"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Date Début :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="tbxDateDebut" Foreground="Gray"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Description :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="tbxDescription" Foreground="Gray"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Budget :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="tbxBudget" Foreground="Gray"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Nbr Employés :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" x:Name="tbxNbrEmployes" Foreground="Gray"/>

                    <ListView x:Name="lvEmployesAssigne" Grid.Row="10" Grid.ColumnSpan="2"
          Margin="0,10" Background="#FFF8F8F8" 
          BorderBrush="#CCC" BorderThickness="1" 
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          MinHeight="200" MaxHeight="400">
                        <ListView.Header>
                            <Grid Background="#EEE" Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Employé" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Heures travaillées" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Salaire pour le projet" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local1:Assignation">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#DDD" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind EmployeMatricule}" 
                               HorizontalAlignment="Center" Foreground="#444"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind HeuresTravaillees}" 
                               HorizontalAlignment="Center" Foreground="#444"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SalaireProjet}" 
                               HorizontalAlignment="Center" Foreground="#444"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Total Salaire :" FontWeight="Bold"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" x:Name="tbxTotalSalaire" Foreground="Gray"/>

                    <Button Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="btnModifier"
                Content="Modifier ce Projet"
                HorizontalAlignment="Left" Width="220" Height="45"
                Background="Orange"  Foreground="White" FontWeight="Bold"
                Click="btnModifier_Click"/>
                </Grid>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
