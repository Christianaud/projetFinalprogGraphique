<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="projet.pages.PageAjouterProjet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:projet.pages"
    xmlns:local2="using:projet.Singletons"
    xmlns:local1="using:projet.classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:classes="using:projet.classes" d:DataContext="{d:DesignInstance Type=classes:Employe}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel x:Name="display" Orientation="Vertical" Spacing="20" Padding="20">
            <TextBlock FontSize="40" FontWeight="ExtraBlack">Addition d'un Projet:</TextBlock>
            <TextBox x:Name="tbxTitre"/>
            <TextBox x:Name="tbxStatut"/>
            <TextBox x:Name="tbxIdClient"/>
            <TextBox x:Name="tbxNomClient"/>
            <DatePicker x:Name="dpDateDebut"/>
            <TextBox x:Name="tbxDescription"/>
            <TextBox x:Name="tbxBudget"/>
            <TextBox x:Name="tbxNbrEmployes"/>
            <TextBox x:Name="tbxTotalSalaire"/>

            <ComboBox x:Name="cmbxEmp"
                DisplayMemberPath="Nom"
                Width="200" 
                SelectionChanged="cmbxEmp_SelectionChanged"/>
            
            <TextBox x:Name="cmbxEmpErreur"/>

            <ListView x:Name="lvAssignations"
          ItemsSource="{Binding employesAssignes}"
          Width="400"
          Height="200"
          Margin="10">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local1:Employe">
                        <StackPanel Orientation="Horizontal"
                        Spacing="20"
                        Background="AliceBlue"
                        Margin="5" Padding="5">
                            <TextBlock Text="{x:Bind Nom}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{x:Bind Prenom}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{x:Bind Matricule}" FontSize="16" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBox x:Name=""/>


            <Button x:Name="btnAjouter" Content="Ajouter" Click="btnAjouter_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
