<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="projet.pages.pageAjoutEmp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:projet.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

        <ScrollViewer>
            <Grid Padding="30" RowSpacing="8" ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>
                    <!-- Erreurs -->
                    <RowDefinition Height="Auto"/>
                    <!-- Matricule -->
                    <RowDefinition Height="Auto"/>
                    <!-- Erreurs -->
                    <RowDefinition Height="Auto"/>
                    <!-- Bouton -->
                </Grid.RowDefinitions>

                <!-- TITRE -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Formulaire Employé"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

                <!-- NOM / PRENOM -->
                <TextBox x:Name="tbxNom" Grid.Row="1" Grid.Column="0" Header="Nom"/>
                <TextBox x:Name="tbxPrenom" Grid.Row="1" Grid.Column="1" Header="Prénom"/>

                <TextBlock x:Name="tblNomErreur" Grid.Row="2" Grid.Column="0" Foreground="Red"/>
                <TextBlock x:Name="tblPrenomErreur" Grid.Row="2" Grid.Column="1" Foreground="Red"/>

                <!-- NAISSANCE / EMBAUCHE -->
                <DatePicker x:Name="dprNaissance" Grid.Row="3" Grid.Column="0" Header="Date de naissance"/>
                <DatePicker x:Name="dprEmbauche" Grid.Row="3" Grid.Column="1" Header="Date d'embauche"/>

                <TextBlock x:Name="tblDateNaissanceErreur" Grid.Row="4" Grid.Column="0" Foreground="Red"/>
                <TextBlock x:Name="tblDateEmbaucheErreur" Grid.Row="4" Grid.Column="1" Foreground="Red"/>

                <!-- EMAIL / ADRESSE -->
                <TextBox x:Name="tbxEmail" Grid.Row="5" Grid.Column="0" Header="Courriel" PlaceholderText="exemple@email.com"/>
                <TextBox x:Name="tbxAdresse" Grid.Row="5" Grid.Column="1" Header="Adresse" PlaceholderText="Adresse complète"/>

                <TextBlock x:Name="tblEmailErreur" Grid.Row="6" Grid.Column="0" Foreground="Red"/>
                <TextBlock x:Name="tblAdresseErreur" Grid.Row="6" Grid.Column="1" Foreground="Red"/>

                <!-- TAUX HORAIRE -->
                <NumberBox x:Name="nbxTauxHoraire"
                       Grid.Row="7" Grid.Column="0"
                       Header="Taux horaire"
                       PlaceholderText="Minimum 15$"
                       Minimum="15"
                       SpinButtonPlacementMode="Compact"/>

                <TextBlock x:Name="tblTauxHoraireErreur" Grid.Row="8" Grid.Column="0" Foreground="Red"/>

                <!-- PHOTO -->
                <TextBox x:Name="tbxPhoto"
                     Grid.Row="9" Grid.ColumnSpan="2"
                     Header="Photo (URL)"
                     PlaceholderText="https://..."/>

                <TextBlock x:Name="tblPhotoErreur" Grid.Row="10" Grid.ColumnSpan="2" Foreground="Red"/>

                <!-- STATUT -->
                <ComboBox x:Name="cmbxStatut"
                      Grid.Row="11"
                      Grid.Column="0"
                      Header="Statut">
                    <x:String>Permanent</x:String>
                    <x:String>Journalier</x:String>
                </ComboBox>

            <TextBlock x:Name="tblStatutErreur" Grid.Row="12" Grid.Column="0" Foreground="Red"/>

            <!-- BOUTON AJOUT -->
                <Button x:Name="btnAjout"
                    Content="Ajouter l'employé"
                    Grid.Row="15"
                    Grid.ColumnSpan="2"
                    Height="45"
                    Background="#0078D4"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="btnAjout_Click"/>
            </Grid>
            </ScrollViewer>
</Page>
